  "peerDependencies": {
    "@capacitor/core": ">=6.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "^8.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
