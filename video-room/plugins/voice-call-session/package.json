{
  "name": "voice-call-session",
  "version": "0.1.0",
  "description": "Keep Voice Room mic + playback alive while the screen is locked",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
